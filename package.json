{
  "name": "setup-sonar-scanner",
  "description": "GitHub Actions to setup Scanner CLI for SonarQube (Server, Cloud)",
  "version": "1.4.0",
  "author": "Dumas Sylvain",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/actions/typescript-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylvainDumas/setup-sonar-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/SylvainDumas/setup-sonar-scanner/issues"
  },
  "keywords": [
    "actions",
    "github",
    "typescript",
    "sonarqube",
    "sonar-scanner"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": "24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "bundle:clean": "rm -fr dist/*",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "modules:clean": "rm -rf node_modules/*",
    "modules:upgrade": "npm run modules:clean && npx npm-check-updates -i --format group --peer && npm install && npm audit fix",
    "modules:revert": "npm run modules:clean && git checkout package.json package-lock.json && npm install",
    "package": "npm run bundle:clean && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@actions/io": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@eslint/compat": "^2.1.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^30.5.1",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "rollup": "^4.63.2",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "undici": "^6.23.0"
  }
}
